# TrustCode API image. Never executes submitted code (worker_mode=queue enforced in production).
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY verification-worker /srv/verification-worker
COPY backend/requirements.txt /srv/backend/requirements.txt
RUN pip install --no-cache-dir "fastapi>=0.115" "uvicorn[standard]>=0.30" "sqlalchemy>=2.0" "pydantic>=2.7" \
      "pydantic-settings>=2.3" "pyjwt>=2.8" "alembic>=1.13" "psycopg2-binary>=2.9" "anthropic>=0.40" \
    && pip install --no-cache-dir /srv/verification-worker
COPY backend /srv/backend
COPY datasets/benchmark /srv/datasets/benchmark
RUN useradd --system --uid 10001 trustcode
USER 10001
WORKDIR /srv/backend
# Only the reverse proxy's address may set X-Forwarded-For (otherwise clients could spoof IPs to dodge rate limits).
ENV TRUSTCODE_BENCHMARK_DIR=/srv/datasets/benchmark TRUSTCODE_WORKER_MODE=queue TRUSTCODE_TRUSTED_PROXIES=127.0.0.1
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health',timeout=4)"
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=\"${TRUSTCODE_TRUSTED_PROXIES:-127.0.0.1}\""]
