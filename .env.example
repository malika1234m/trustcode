# Copy to .env and fill in. NEVER commit .env.
TRUSTCODE_ENV=production
POSTGRES_PASSWORD=change-me-long-random
TRUSTCODE_JWT_SECRET=generate-with-openssl-rand-hex-32
TRUSTCODE_RUN_TESTS=true
# Address/subnet of your reverse proxy as seen from INSIDE the api container (only it may set X-Forwarded-For).
# With a host-level proxy this is the Docker bridge gateway: docker network inspect trustcode_default -f '{{(index .IPAM.Config 0).Gateway}}'
# Never use '*' (clients could spoof IPs) or 127.0.0.1 under Docker (all users would share one rate-limit bucket).
TRUSTCODE_TRUSTED_PROXIES=
# Optional LLM explanations (Anthropic). Leave empty to use deterministic explanations only.
TRUSTCODE_ANTHROPIC_API_KEY=
TRUSTCODE_LLM_MODEL=claude-opus-5-5
TRUSTCODE_CORS_ORIGINS=
