{
  "name": "trustcode",
  "displayName": "TrustCode — Verify AI-Generated Code",
  "description": "Check AI-generated Python, JavaScript and TypeScript with real evidence: security patterns, lint, dependency checks and tests. See what was checked, what was found, and what was NOT verified.",
  "version": "0.4.1",
  "publisher": "trustcode-research",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trustcode",
          "title": "TrustCode",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "trustcode": [
        {
          "type": "webview",
          "id": "trustcode.panel",
          "name": "Verify AI Code"
        }
      ]
    },
    "commands": [
      {
        "command": "trustcode.verifySelection",
        "title": "TrustCode: Verify Selected Code",
        "icon": "$(shield)"
      },
      {
        "command": "trustcode.signIn",
        "title": "TrustCode: Sign In"
      },
      {
        "command": "trustcode.signOut",
        "title": "TrustCode: Sign Out"
      },
      {
        "command": "trustcode.setExperienceLevel",
        "title": "TrustCode: Set Experience Level"
      },
      {
        "command": "trustcode.privacySettings",
        "title": "TrustCode: Privacy & History Settings"
      },
      {
        "command": "trustcode.startExperiment",
        "title": "TrustCode: Join Research Study"
      },
      {
        "command": "trustcode.forgetConsent",
        "title": "TrustCode: Ask Before Sending Code Again"
      },
      {
        "command": "trustcode.deleteMyData",
        "title": "TrustCode: Delete My Account and Data"
      },
      {
        "command": "trustcode.clearFindings",
        "title": "TrustCode: Clear Findings from Editor"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "trustcode.verifySelection",
          "when": "editorHasSelection",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "TrustCode",
      "properties": {
        "trustcode.backendUrl": {
          "type": "string",
          "default": "https://trustcode-api.vercel.app",
          "description": "TrustCode server URL. Code is only sent here after you confirm. Use http://127.0.0.1:8000 with mode 'local' to keep code on your machine.",
          "scope": "application"
        },
        "trustcode.mode": {
          "type": "string",
          "enum": [
            "local",
            "account"
          ],
          "default": "account",
          "description": "account: sign in to a TrustCode server (default). local: single-user backend on this machine, no account (reads ~/.trustcode/local-secret).",
          "scope": "application"
        },
        "trustcode.requestTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5
        },
        "trustcode.useLlmExplanations": {
          "type": "boolean",
          "default": false,
          "description": "Request LLM-written explanations (sends finding details to the configured LLM provider via the backend). Off by default.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies",
    "test:integration": "npm run compile && node out/test/integration/run.js"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/malika1234m/trustcode.git"
  },
  "icon": "media/icon.png",
  "homepage": "https://github.com/malika1234m/trustcode#readme",
  "bugs": {
    "url": "https://github.com/malika1234m/trustcode/issues"
  },
  "keywords": [
    "ai",
    "chatgpt",
    "code review",
    "copilot",
    "javascript",
    "llm",
    "python",
    "security",
    "semgrep",
    "trust",
    "typescript",
    "verification"
  ],
  "galleryBanner": {
    "color": "#0C1322",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "TrustCode never executes workspace code locally, and its security-relevant settings are application-scoped."
    },
    "virtualWorkspaces": true
  }
}
