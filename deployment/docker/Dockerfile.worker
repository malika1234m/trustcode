# TrustCode verification worker. Runs static tools on submitted code and launches the isolated
# test sandbox (trustcode-sandbox image) through the Docker daemon. See docs/security/threat_model.md (T-9):
# access to the Docker socket is root-equivalent on the host, so run the worker on a dedicated host/VM.
FROM docker:27-cli AS dockercli

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
# Debian's docker.io (20.10) is too old for current daemons (min API 1.44); use the official CLI.
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /srv
COPY verification-worker /srv/verification-worker
RUN pip install --no-cache-dir "sqlalchemy>=2.0" "pydantic>=2.7" "pydantic-settings>=2.3" "pyjwt>=2.8" \
      "psycopg2-binary>=2.9" "ruff==0.6.9" "semgrep==1.79.0" "fastapi>=0.115" "anthropic>=0.40" \
    && pip install --no-cache-dir /srv/verification-worker
COPY backend /srv/backend
WORKDIR /srv/backend
ENV TRUSTCODE_WORKER_MODE=queue
CMD ["python", "-m", "app.worker_main"]
