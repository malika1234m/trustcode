 "components": {
  "schemas": {
   "DecisionIn": {
    "properties": {
     "decision": {
      "type": "string",
      "enum": [
       "accept",
       "modify",
       "reject"
      ],
      "title": "Decision"
     },
     "confidence": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 100.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Confidence"
     },
     "rationale": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 2000
       },
       {
        "type": "null"
       }
      ],
      "title": "Rationale"
     }
    },
    "type": "object",
    "required": [
     "decision"
    ],
    "title": "DecisionIn"
   },
   "EventIn": {
    "properties": {
     "trial_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 32
       },
       {
        "type": "null"
       }
      ],
      "title": "Trial Id"
     },
     "type": {
      "type": "string",
      "enum": [
       "evidence_expand",
       "evidence_collapse",
       "explanation_level_view",
       "unverified_view",
       "request_more_checks",
       "code_scroll",
       "panel_focus",
       "panel_blur"
      ],
      "title": "Type"
     },
     "payload": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Payload"
     }
    },
    "type": "object",
    "required": [
     "type"
    ],
    "title": "EventIn"
   },
   "FeedbackIn": {
    "properties": {
     "job_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 32
       },
       {
        "type": "null"
       }
      ],
      "title": "Job Id"
     },
     "finding_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 20
       },
       {
        "type": "null"
       }
      ],
      "title": "Finding Id"
     },
     "rating": {
      "type": "string",
      "enum": [
       "helpful",
       "not_helpful",
       "too_technical",
       "too_simple",
       "incorrect"
      ],
      "title": "Rating"
     },
     "comment": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 2000
       },
